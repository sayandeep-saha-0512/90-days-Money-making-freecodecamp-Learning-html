# Keep formatting consistent across editors and operating systems.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.js]
# JavaScript follows the project's two-space indentation convention.
indent_size = 2

[*.md]
# Preserve intentional Markdown line spacing.
trim_trailing_whitespace = false
